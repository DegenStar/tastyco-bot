# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Linters and type checkers
.mypy_cache/
.ruff_cache/
.pyre/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db

# Local environment files
.env
.env.*
!.env.example

# Local credentials (legacy tracked files are not protected by these rules)
accounts.txt
sctg.txt
captcha_key.txt
proxy.txt

# Keep the committed config templates visible; replace their placeholders locally.
config/*.txt
!config/*.txt
